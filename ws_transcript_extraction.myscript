<doc>Fill explanations for Detailed Idea plus Investment use case steps and notes with module-first transcript matching.</doc>
IF {DETAILED_IDEA_INVESTMENT_START_01} is not empty:
    Update {TARGET_FILE}.container_DetailedIdeaInvestment.module_DetailedIdeaInvestment
        
        {IDEA_COUNTER} = 0
        
        For each detailedIdea:
        {IDEA_COUNTER} = {IDEA_COUNTER} + 1

            For each detailedIdeaStep:

                For each PostIt in note:
                    {SNIPPET} = Extract parts of {DETAILED_IDEA_INVESTMENT_TRANSCRIPT_{IDEA_COUNTER}} where PostIt.note is described.
                    
                    If {SNIPPET} is empty
                        {SNIPPET} = Extract parts of {WS_TRANSCRIPT} where PostIt.note is described.

