{WORKSHOP_OUTCOME_02} = "Übersicht der notwendigEen Rahmenbedingungen"
{WORKSHOP_OUTCOME_03} = "Roadmap für die Umsetzung der Use Cases"
{WORKSHOP_OUTCOME_04} = ""
{WORKSHOP_OUTCOME_05} = ""
{WORKSHOP_OUTCOME_06} = ""

