{MD_LIFE_CYCLE_STAGE_02_DESCRIPTION} = "Consider how the installation and commissioning process is influenced when buying versus using a machine you don’t own."
{MD_LIFE_CYCLE_STAGE_03_NAME} = "Standard Operation"
