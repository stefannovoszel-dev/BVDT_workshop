<doc>Mapping section that transforms configured constants into a schema-compliant workshop JSON object.</doc>
MAPPING:

Structure for the data mapping = {JSON_SCHEMA}

<doc>Here you pre-create the JSON structure with all the information you already know. This is an important step to create anchors that can be used by the next steps.
You use a combination of the internal variables you have configured above and the property.names as defined in the JSON schema.</doc>
Create Workshop with:

    Workshop.goal = {WORKSHOP_GOAL}

    <doc>Copy all configured focus points into the workshop focus collection.</doc>
    For each {WORKSHOP_FOCUS_XX}
        append {WORKSHOP_FOCUS_XX} to Workshop.focus

    <doc>Copy all configured expected outcomes into the workshop outcome collection.</doc>
    For each {WORKSHOP_OUTCOME_XX}
        append {WORKSHOP_OUTCOME_XX} to Workshop.expectedOutcome
    
    Workshop.date = {WORKSHOP_DATE}

    <doc>Create participant entries including nested company objects.</doc>
    For each {PARTICIPANT_XX}
        create Participant with:
            name = {PARTICIPANT_XX_NAME}
            role = {PARTICIPANT_XX_ROLE}
            
            Create Company with:
                Name = {PARTICIPANT_XX_COMPANY_NAME}
                Industry = {PARTICIPANT_XX_COMPANY_INDUSTRY}
            set Participant.company = Company
            
            email = {PARTICIPANT_XX_EMAIL}
        append Participant to Workshop.participant

    Workshop.company.Name = {CUSTOMER_NAME}
    Workshop.company.Industry = {INDUSTRY}

    <doc>Initialize the Different Views container and pre-create rating placeholders by perspective and category.</doc>
    IF {CT_DIFF_VIEWS_RATED_ID} is not empty
        Create Container_DifferentViewsRated with:
            id = {CT_DIFF_VIEWS_RATED_ID}
            headline = {CT_DIFF_VIEWS_RATED_HEADLINE}
            
            For each {MD_XX_DIFF_VIEWS_RATED}
                create Module_DifferentViewsRated with:
                    id = {MD_XX_DIFF_VIEWS_RATED_ID}
                    perspective = {MD_XX_DIFF_VIEWS_RATED_PERSPECTIVE}

                    i = 1
                    For i to {MD_DIFF_VIEWS_RATED_ITEM_COUNTER}
                        create WorkshopItemRated with:
                            id = "ITEM_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {CT_DIFF_VIEWS_RATED_ID} + {MD_XX_DIFF_VIEWS_RATED_ID} + i)

                            For each {MD_DIFF_VIEWS_RATED_CATEGORY_XX}
                                create CategoryRating with:
                                    category = {MD_DIFF_VIEWS_RATED_CATEGORY_XX}
                                append CategoryRating to WorkshopItemRated.categoryRating

                        append WorkshopItemRated to Module_DifferentViewsRated.workshopItemRated

                append Module_DifferentViewsRated to Container_DifferentViewsRated.module_DifferentViewsRated
        Workshop.container_DifferentViewsRated = Container_DifferentViewsRated

    <doc>Initialize Value/Effort container and add one module per configured team.</doc>
    IF {CT_VALUE_EFFORT_MATRIX_ID} is not empty
        Create Container_ValueEffortMatrix with:
            id = {CT_VALUE_EFFORT_MATRIX_ID}
            headline = {CT_VALUE_EFFORT_MATRIX_HEADLINE}
            
            For each {MD_XX_VALUE_EFFORT_MATRIX}
                create Module_ValueEffortMatrix with:
                    id = {MD_XX_VALUE_EFFORT_MATRIX_ID}
                    teamName = {MD_XX_VALUE_EFFORT_MATRIX_TEAM}
                append Module_ValueEffortMatrix to Container_ValueEffortMatrix.module_ValueEffortMatrix
        Workshop.container_ValueEffortMatrix = Container_ValueEffortMatrix

    <doc>Create the capability matrix with one capability entry per configured capability pair.</doc>
    IF {MD_CAPABILITY_MATRIX_ID} is not empty
        Create Module_CapabilityMatrix with:
            id = {MD_CAPABILITY_MATRIX_ID}
            headline = {MD_CAPABILITY_MATRIX_HEADLINE}
            
            For each {CAPABILITY_XX}
                create Capability with:
                    id = "CAPABILITY_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {CAPABILITY_XX_NAME})
                    name = {CAPABILITY_XX_NAME}
                    description = {CAPABILITY_XX_DESCRIPTION}
                append Capability to Module_CapabilityMatrix.capability
        Workshop.module_CapabilityMatrix = Module_CapabilityMatrix

    <doc>Initialize detailed working plan container, stages, and team-specific workplan groups.</doc>
    IF {CT_DETAILED_WORKING_PLAN_ID} is not empty
        Create Container_DetailedWorkingPlan with:
            id = {CT_DETAILED_WORKING_PLAN_ID}
            description = {CT_DETAILED_WORKING_PLAN_DESCRIPTION}
            
            For each {CT_DETAILED_WORKING_PLAN_STAGE_XX}
                append {CT_DETAILED_WORKING_PLAN_STAGE_XX} to Container_DetailedWorkingPlan.stage

            For each {MD_XX_DETAILED_WORKING_PLAN}
                create Module_DetailedWorkingPlan with:
                    id = {MD_XX_DETAILED_WORKING_PLAN_ID}
                    teamName = {MD_XX_DETAILED_WORKING_PLAN_TEAM}

                    create WorkplanItemGroupExplanationData with:
                        id = "WP_GROUP_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {MD_XX_DETAILED_WORKING_PLAN_ID} + {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_DESCRIPTION})
                        description = {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_DESCRIPTION}

                        For each {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_EXPLANATION_XX}
                            create WorkplanItemTwoStep with:
                                topic = {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_EXPLANATION_XX_TOPIC}
                                description = {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_EXPLANATION_XX_DESCRIPTION}
                            append WorkplanItemTwoStep to WorkplanItemGroupExplanationData.workplanItemTwoStep

                        For each {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_DATA_XX}
                            create WorkplanItemOneStep with:
                                description = {MD_DETAILED_WORKING_PLAN_EXPLANATION_DATA_DATA_XX_TOPIC}
                            append WorkplanItemOneStep to WorkplanItemGroupExplanationData.workplanItemOneStep
                    
                    append WorkplanItemGroupExplanationData to Module_DetailedWorkingPlan.workplanItemGroupExplanationData

                    create WorkplanItemGroupRequiredResources with:
                        id = "WP_GROUP_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {MD_XX_DETAILED_WORKING_PLAN_ID} + {MD_DETAILED_WORKING_PLAN_RESOURCES_DESCRIPTION})
                        description = {MD_DETAILED_WORKING_PLAN_RESOURCES_DESCRIPTION}

                        For each {MD_DETAILED_WORKING_PLAN_RESOURCES_XX}
                            create WorkplanItemOneStep with:
                                description = {MD_DETAILED_WORKING_PLAN_RESOURCES_XX_TOPIC}
                            append WorkplanItemOneStep to WorkplanItemGroupRequiredResources.workplanItemOneStep
                    
                    append WorkplanItemGroupRequiredResources to Module_DetailedWorkingPlan.workplanItemGroupRequiredResources
                
                append Module_DetailedWorkingPlan to Container_DetailedWorkingPlan.module_DetailedWorkingPlan
        Workshop.container_DetailedWorkingPlan = Container_DetailedWorkingPlan

    <doc>Initialize user journey container and pre-create step prompts for each team.</doc>
    IF {CT_USER_JOURNEY_ID} is not empty
        Create Container_UserJourney with:
            id = {CT_USER_JOURNEY_ID}
            headline = {CT_USER_JOURNEY_HEADLINE}
            
            For each {MD_XX_USER_JOURNEY}
                create Module_UserJourney with:
                    id = {MD_XX_USER_JOURNEY_ID}
                    teamName = {MD_XX_USER_JOURNEY_TEAM}

                    For each {MD_USER_JOURNEY_STEP_XX}
                        create UserJourneyStep with:
                            id = "UJ_STEP_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {MD_XX_USER_JOURNEY_ID} + {MD_USER_JOURNEY_STEP_XX})
                            description = {MD_USER_JOURNEY_STEP_XX}
                        append UserJourneyStep to Module_UserJourney.userJourneyStep
                
                append Module_UserJourney to Container_UserJourney.module_UserJourney
        Workshop.container_UserJourney = Container_UserJourney

    <doc>Create free-association module shell that contains the opening question.</doc>
    IF {MD_FREE_ASSOCIATION_ID} is not empty
        Create Module_FreeAssociation with:
            id = {MD_FREE_ASSOCIATION_ID}
            headline = {MD_FREE_ASSOCIATION_HEADLINE}
            question = {MD_FREE_ASSOCIATION_QUESTION}
        append Module_FreeAssociation to Workshop.module_FreeAssociation

    <doc>Initialize the staged offering portfolio module with its stages and topics.</doc>
    IF {MD_STAGED_OFFERING_PORTFOLIO_ID} is not empty
        Create Module_StagedOfferingPortfolio with:
            id = {MD_STAGED_OFFERING_PORTFOLIO_ID}
            headline = {MD_STAGED_OFFERING_PORTFOLIO_HEADLINE}

            For each {MD_STAGED_OFFERING_PORTFOLIO_STAGE_XX}
                create PortfolioItemGroup with:
                    id = {MD_STAGED_OFFERING_PORTFOLIO_STAGE_XX_ID}
                    headline = {MD_STAGED_OFFERING_PORTFOLIO_STAGE_XX_HEADLINE}

                    For each {MD_STAGED_OFFERING_PORTFOLIO_STAGE_ITEM_TOPIC_XX}
                        create PortfolioItem with:
                            id = "STAGE_ITEM_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {MD_STAGED_OFFERING_PORTFOLIO_STAGE_XX_ID} + {MD_STAGED_OFFERING_PORTFOLIO_STAGE_ITEM_TOPIC_XX})
                            topic = {MD_STAGED_OFFERING_PORTFOLIO_STAGE_ITEM_TOPIC_XX}
                        append PortfolioItem to PortfolioItemGroup.portfolioItem
                append PortfolioItemGroup to Module_StagedOfferingPortfolio.portfolioItemGroup
        Workshop.module_StagedOfferingPortfolio = Module_StagedOfferingPortfolio

{WORKSHOP_JSON_OBJECT} = Workshop


OUTPUT:

<doc>Here you generate the first version of the JSON file as an input for the next update steps.</doc>
Return a JSON file with the name {TARGET_FILE} containing the serialized {WORKSHOP_JSON_OBJECT} adhering to the structure defined in {JSON_SCHEMA}.
