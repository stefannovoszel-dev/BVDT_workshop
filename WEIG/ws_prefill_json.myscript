{MD_01_DETAILED_IDEA_INVESTMENT_TEAM} = "Team RED"
{MD_01_DETAILED_IDEA_INVESTMENT_ID} = "MODULE_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {MD_01_DETAILED_IDEA_INVESTMENT_TEAM} + {CT_DETAILED_IDEA_INVESTMENT_ID})
{MD_02_DETAILED_IDEA_INVESTMENT_TEAM} = "Team GREEN"
