{CT_VALUE_EFFORT_MATRIX_HEADLINE} = "Welche Use Cases sollen umgesetzt werden?"
{CT_VALUE_EFFORT_MATRIX_ID} = "CONTAINER_" + {METHOD_ID_GENERATOR}({CUSTOMER_NAME}, {CT_VALUE_EFFORT_MATRIX_HEADLINE})
